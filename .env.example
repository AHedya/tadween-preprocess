OTEL_EXPORTER_OTLP_ENDPOINT="https://telemetry.hedya.dev"
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer authkey"
SERVICE_NAME=tadween_preprocess_worker
ENVIRONMENT=production
# max workers for gated runner
# Number of active concurrent workers. Resamples slots in resource-managed runners and semaphores in the others
PREPROCESS_DOWNLOAD_WORKERS=
PREPROCESS_CPU_WORKERS=
PREPROCESS_UPLOAD_WORKERS=
# Download limit (in MB) to prevent abuse via oversized files. Defaults to 2048 (2GB)
PREPROCESS_MAX_FILE_SIZE_MB=2048
# Total physical disk budget in bytes. Unset = auto-detect (80% of free disk). 0 = unlimited.
PREPROCESS_DISK_BUDGET_BYTES=
# Disk claim multiplier on the downloaded file size. Defaults to 1.1.
PREPROCESS_DISK_MULTIPLIER=1.1
# Total physical RAM budget in MB. Unset = auto-detect (80% of available mem). 0 = unlimited.
PREPROCESS_RAM_BUDGET_MB=
# RAM claim per CPU-bound process in MB. Defaults to 100.
PREPROCESS_RAM_PER_CPU_MB=100
